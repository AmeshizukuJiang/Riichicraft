{
  "aquifers_enabled": false,
  "default_block": {
    "Name": "minecraft:stone"
  },
  "default_fluid": {
    "Name": "minecraft:water"
  },
  "disable_mob_generation": true,
  "legacy_random_source": false,
  "noise": {
    "height": 256,
    "min_y": 0,
    "size_horizontal": 1,
    "size_vertical": 1
  },
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": 0,
    "temperature": "riichicraft:terrain_test/regions",
    "vegetation": 0,
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "preliminary_surface_level": {
      "type": "minecraft:find_top_surface",
      "density": "riichicraft:terrain_test/base_density",
      "upper_bound": 255,
      "lower_bound": 0,
      "cell_height": 8
    },
    "final_density": {
      "type": "minecraft:interpolated",
      "argument": "riichicraft:terrain_test/base_density"
    },
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0
  },
  "ore_veins_enabled": false,
  "sea_level": 0,
  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "riichicraft:terrain_test/bedrock",
          "true_at_and_below": {
            "above_bottom": 0
          },
          "false_at_and_above": {
            "above_bottom": 1
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:bedrock"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "riichicraft:test_region_a"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:lime_concrete"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "riichicraft:test_region_b"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:orange_concrete"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:biome",
          "biome_is": "riichicraft:test_region_c"
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:light_blue_concrete"
          }
        }
      },
      {
        "type": "minecraft:block",
        "result_state": {
          "Name": "minecraft:stone"
        }
      }
    ]
  }
}
